+#ifndef NEXAUI_TEST_MACOS_TEXT_VALUE_FIXTURE_H
+#define NEXAUI_TEST_MACOS_TEXT_VALUE_FIXTURE_H
+#import <AppKit/AppKit.h>
+#include "nexaui/nexaui.h"
+#include "window_internal.h"
+#include "fixture_font.h"
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(x) do {if(!(x)){fprintf(stderr,"%s:%d: %s\n",__FILE__,__LINE__,#x);return 1;}}while(0)
+typedef struct allocation {void *p;size_t size;} allocation;
+typedef struct heap {allocation live[4096];size_t count,calls;int fail,when;void (*hook)(void *);void *user;} heap;
+static void call(heap *h,int when) {
+    if(h->hook && h->when==when){void (*f)(void *)=h->hook;h->hook=NULL;f(h->user);}
+}
+static void *allocate(void *user,size_t bytes) {
+    heap *h=user;++h->calls;call(h,1);if(h->fail){h->fail=0;return NULL;}
+    void *p=malloc(bytes);if(p){if(h->count==4096)abort();h->live[h->count++]=(allocation){p,bytes};}return p;
+}
+static void deallocate(void *user,void *p,size_t bytes) {
+    heap *h=user;size_t at=0;while(at<h->count && h->live[at].p!=p)++at;
+    if(at==h->count || h->live[at].size!=bytes)abort();h->live[at]=h->live[--h->count];call(h,2);free(p);
+}
+typedef struct scene {
+    nx_context *ctx;nx_window *window;nx_font *font;nx_font_collection *fonts;
+    nx_text_field *fields[65];nx_numeric_field *number;
+    unsigned char font_bytes[512];heap core,native;
+    size_t field_count;int disabled,modal,kind,password,clicks,callback_fired;nx_result callback_result;
+} scene;
+static nx_semantic_desc semantic(uint64_t id,uint64_t parent,nx_semantic_role role,const char *name) {
+    nx_semantic_desc d={0};d.id=id;d.parent_id=parent;d.role=role;d.name=(nx_utf8_span){name,strlen(name)};d.bounds=(nx_rect){0,0,640,480};return d;
+}
+static int frame(scene *s) {
+    CHECK(nx_begin_frame(s->ctx,640,480,0)==NX_OK);
+    nx_semantic_desc root=semantic(1,0,NX_ROLE_WINDOW,"AX editable values");CHECK(nx_semantics_add(s->ctx,&root,NULL)==NX_OK);
+    root=semantic(10,1,s->kind==1?NX_ROLE_CUSTOM:NX_ROLE_PANEL,"Ancestor");CHECK(nx_semantics_add(s->ctx,&root,NULL)==NX_OK);
+    root=semantic(20,1,NX_ROLE_PANEL,"Other ancestor");CHECK(nx_semantics_add(s->ctx,&root,NULL)==NX_OK);
+    root=semantic(30,s->kind==2?20:10,NX_ROLE_PANEL,"Inner");CHECK(nx_semantics_add(s->ctx,&root,NULL)==NX_OK);
+    if(s->modal) {
+        nx_overlay_desc d={0};d.panel.id=900;d.backdrop_id=901;d.panel.name=(nx_utf8_span){"Modal",5};d.panel.bounds=(nx_rect){400,0,200,100};
+        int dismissed;CHECK(nx_modal_begin(s->ctx,&d,&dismissed)==NX_OK && nx_overlay_end(s->ctx)==NX_OK);
+    }
+    for(size_t i=0;i<s->field_count;++i) {
+        nx_text_field_desc d={0};d.id=1200+i;d.parent_id=30;d.bounds=(nx_rect){10,(float)i*24,220,22};
+        d.name=(nx_utf8_span){"Editable",8};d.fonts=s->fonts;d.pixels_per_em=16;d.glyph_cache_bytes=65536;
+        d.disabled=i==2 || (!i && s->disabled);d.password=i==3 || (!i && s->password);d.multiline=i==4;
+        nx_interaction_state state;int valid,submitted;
+        CHECK(nx_text_field_widget(s->ctx,&d,s->fields[i],&state,&valid,&submitted)==NX_OK);
+    }
+    nx_numeric_field_desc n={0};n.id=1500;n.parent_id=1;n.bounds=(nx_rect){260,10,100,24};n.name=(nx_utf8_span){"Numeric",7};
+    n.fonts=s->fonts;n.pixels_per_em=16;n.glyph_cache_bytes=65536;n.minimum=0;n.maximum=100;
+    nx_interaction_state state;int valid;CHECK(nx_numeric_field_widget(s->ctx,&n,s->number,&state,&valid)==NX_OK);
+    root=semantic(1600,1,NX_ROLE_TEXT_FIELD,"Unbound");root.actions=NX_ACTION_SET_VALUE;root.value=(nx_utf8_span){"custom",6};CHECK(nx_semantics_add(s->ctx,&root,NULL)==NX_OK);
+    for(uint64_t i=0;i<65;++i) {
+        nx_control_desc c={0};c.id=2000+i;c.parent_id=1;c.name=(nx_utf8_span){"Queued",6};c.bounds=(nx_rect){400,200,100,24};
+        CHECK(nx_button(s->ctx,&c,&state)==NX_OK);s->clicks+=state.clicked;
+    }
+    CHECK(nx_end_frame(s->ctx)==NX_OK);return 0;
+}
+static int publish(scene *s) {CHECK(frame(s)==0 && nx_window_publish_semantics(s->window,s->ctx)==NX_OK);return 0;}
+static id find_element(id root,uint64_t identity) {
+    NSString *wanted=[NSString stringWithFormat:@"nexa-%016llx",(unsigned long long)identity];
+    if([[root accessibilityIdentifier] isEqual:wanted])return root;
+    for(id child in [root accessibilityChildren]){id result=find_element(child,identity);if(result)return result;}return nil;
+}
+static id element(scene *s,uint64_t identity) {return find_element(nx_window_native_nsview(s->window),identity);}
+static int text(nx_text_field *f,const char *expected) {
+    nx_utf8_span got;CHECK(nx_text_field_text(f,&got)==NX_OK && got.length==strlen(expected) && (!got.length || !memcmp(got.data,expected,got.length)));return 0;
+}
+static int advance(scene *s,size_t expected) {
+    size_t routed=999;nx_result result=nx_window_route_events(s->window,s->ctx,&routed);
+    if(result!=NX_OK || routed!=expected)fprintf(stderr,"route result=%d count=%zu expected=%zu\n",result,routed,expected);
+    CHECK(result==NX_OK && routed==expected && publish(s)==0 && ![nx_window_native_nswindow(s->window) isVisible]);return 0;
+}
+static int setup(scene *s) {
+    if(!s->field_count)s->field_count=6;
+    font_fixture(s->font_bytes);CHECK(nx_font_open(s->font_bytes,sizeof(s->font_bytes),NULL,&s->font)==NX_OK);
+    CHECK(nx_font_collection_create(NULL,&s->fonts)==NX_OK && nx_font_collection_add(s->fonts,s->font)==NX_OK);
+    for(size_t i=0;i<s->field_count;++i) {
+        const char *initial=i==4?"one\ntwo":i==5?"peer":"seed";
+        CHECK((i==3?nx_text_field_create_password(initial,strlen(initial),&s->fields[i]):nx_text_field_create(initial,strlen(initial),131072,&s->fields[i]))==NX_OK);
+    }
+    CHECK(nx_text_field_set_read_only(s->fields[1],1)==NX_OK && nx_numeric_field_create(42,8192,&s->number)==NX_OK);
+    nx_context_desc cd={0};cd.allocator=(nx_allocator){&s->core,allocate,deallocate};CHECK(nx_context_create(&cd,&s->ctx)==NX_OK);
+    nx_window_desc wd={"Hidden AX value contract",640,480,NX_WINDOW_HIDDEN,{&s->native,allocate,deallocate}};
+    CHECK(nx_window_create(&wd,&s->window)==NX_OK && publish(s)==0 && ![nx_window_native_nswindow(s->window) isVisible]);
+    size_t initial=0;CHECK(nx_window_route_events(s->window,s->ctx,&initial)==NX_OK);return 0;
+}
+static int cleanup(scene *s) {
+    if(s->window){CHECK(![nx_window_native_nswindow(s->window) isVisible]);nx_window_destroy(s->window);}
+    nx_context_destroy(s->ctx);for(size_t i=0;i<s->field_count;++i)nx_text_field_destroy(s->fields[i]);
+    nx_numeric_field_destroy(s->number);nx_font_collection_destroy(s->fonts);nx_font_close(s->font);
+    CHECK(!s->core.count && !s->native.count);return 0;
+}
+#endif
diff --git a/tests/test_macos_text_value.m b/tests/test_macos_text_value.m
