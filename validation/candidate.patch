+++ b/tests/test_macos_text_value.m
@@ -0,0 +1,21 @@
+#include "macos_text_value_fixture.h"
+
+static int operations(void) {
+    scene s={0};CHECK(setup(&s)==0);id editor=[element(&s,1200) retain];
+    CHECK(editor && [editor isAccessibilitySelectorAllowed:@selector(setAccessibilityValue:)]);
+    CHECK(![element(&s,1201) isAccessibilitySelectorAllowed:@selector(setAccessibilityValue:)] &&
+          ![element(&s,1202) isAccessibilitySelectorAllowed:@selector(setAccessibilityValue:)] &&
+          ![element(&s,1203) isAccessibilitySelectorAllowed:@selector(setAccessibilityValue:)] &&
+          ![element(&s,1600) isAccessibilitySelectorAllowed:@selector(setAccessibilityValue:)]);
+    NSString *held=[[editor accessibilityValue] retain];
+    NSMutableString *input=[NSMutableString stringWithString:@"東京🌍"];
+    [editor setAccessibilityValue:input];[input setString:@"changed after admission"];
+    CHECK(text(s.fields[0],"seed")==0 && advance(&s,1)==0 && text(s.fields[0],"\xe6\x9d\xb1\xe4\xba\xac\xf0\x9f\x8c\x8d")==0);
+    CHECK([[editor accessibilityValue] isEqual:@"東京🌍"] && [held isEqual:@"seed"] && text(s.fields[5],"peer")==0);
+    [editor setAccessibilityValue:@""];CHECK(advance(&s,1)==0 && text(s.fields[0],"")==0);
+    [element(&s,1204) setAccessibilityValue:@"new\nlines"];CHECK(advance(&s,1)==0 && text(s.fields[4],"new\nlines")==0);
+    [element(&s,1500) setAccessibilityValue:@"73.5"];CHECK(advance(&s,1)==0);double number=0;
+    CHECK(nx_numeric_field_value(s.number,&number)==NX_OK && number==73.5);
+    [held release];[editor release];CHECK(cleanup(&s)==0);puts("AppKit owned editable Value Unicode/empty/multiline/numeric/model isolation passed");return 0;
+}
+int main(void) {@autoreleasepool{return operations();}}
