+#define CHECK(x) do {if(!(x)){fprintf(stderr,"%s:%d: %s\n",__FILE__,__LINE__,#x);return 1;}}while(0)
+typedef struct allocation {void *p;size_t size;} allocation;
+typedef struct heap {allocation live[4096];size_t count,calls,threshold,hook_bytes;int fail,when,free_after_allocate,free_ready;void (*hook)(void *);void *user;} heap;
+static void call(heap *h,int when,size_t bytes) {
+    if(h->hook && h->when==when && (when==2 && h->free_after_allocate?h->free_ready:bytes>=h->threshold)) {
+        void (*f)(void *)=h->hook;h->hook=NULL;h->hook_bytes=bytes;f(h->user);
+    }
+}
+static void *allocate(void *user,size_t bytes) {
+    heap *h=user;++h->calls;if(h->free_after_allocate && bytes>=h->threshold)h->free_ready=1;
+    call(h,1,bytes);if(h->fail){h->fail=0;return NULL;}
+    void *p=malloc(bytes);if(p){if(h->count==4096)abort();h->live[h->count++]=(allocation){p,bytes};}return p;
+}
+static void deallocate(void *user,void *p,size_t bytes) {
+    heap *h=user;size_t at=0;while(at<h->count && h->live[at].p!=p)++at;
+    if(at==h->count || h->live[at].size!=bytes)abort();h->live[at]=h->live[--h->count];call(h,2,bytes);free(p);
+}
