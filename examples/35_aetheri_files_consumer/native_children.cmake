# Optional real child programs used by the original Files native tests.
# No replacement executable, original source patch or application installation.
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/check_source.py"
    "${AETHERI_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}/native-inputs.json"
    COMMAND_ERROR_IS_FATAL ANY)
find_package(PkgConfig REQUIRED)
find_package(SDL3 3.4.20 EXACT CONFIG REQUIRED)
find_package(SDL3_ttf 3.2.2 EXACT CONFIG REQUIRED)
find_package(Freetype 2.15.0 EXACT REQUIRED)
pkg_check_modules(HARFBUZZ REQUIRED harfbuzz=15.0.0)
pkg_check_modules(TERMINAL_WAYLAND REQUIRED IMPORTED_TARGET wayland-client=1.26.0)
add_library(files_original_modal STATIC "${original}/editor/modal.c")
target_link_libraries(files_original_modal PUBLIC files_original_document)
add_library(files_original_editor_view STATIC "${original}/editor/view.c")
target_compile_definitions(files_original_editor_view PRIVATE _GNU_SOURCE)
target_link_libraries(files_original_editor_view PUBLIC files_original_modal)
add_executable(aetheri_editor_candidate "${original}/editor/main.c")
target_link_libraries(aetheri_editor_candidate PRIVATE files_original_file files_original_editor_view)
add_library(files_original_terminal_model STATIC "${original}/terminal/model.c"
    "${original}/terminal/paste.c" "${original}/terminal/composition.c")
add_library(files_original_terminal_pty STATIC "${original}/terminal/pty.c")
option(NEXAUI_AETHERI_MUSL_COMPAT "Reuse the existing original-Terminal Linux/musl syscall bridge" OFF)
if(NEXAUI_AETHERI_MUSL_COMPAT)
    set(files_musl_bridge "${CMAKE_CURRENT_LIST_DIR}/../23_aetheri_terminal_view")
    add_library(files_terminal_musl_compat STATIC "${files_musl_bridge}/musl_syscalls.c")
    target_compile_options(files_original_terminal_pty PRIVATE -include "${files_musl_bridge}/musl_syscalls.h")
    target_link_libraries(files_original_terminal_pty PUBLIC files_terminal_musl_compat)
    list(APPEND checked_targets files_terminal_musl_compat)
endif()
add_library(files_original_terminal_session STATIC "${original}/terminal/session.c")
target_link_libraries(files_original_terminal_session PUBLIC files_original_terminal_model files_original_terminal_pty)
add_library(files_original_terminal_clipboard STATIC "${original}/terminal/clipboard.c")
target_link_libraries(files_original_terminal_clipboard PUBLIC PkgConfig::TERMINAL_WAYLAND Threads::Threads)
foreach(target files_original_terminal_model files_original_terminal_pty
        files_original_terminal_session files_original_terminal_clipboard)
    target_include_directories(${target} PUBLIC "${original}")
endforeach()
add_executable(aetheri_terminal_candidate "${original}/terminal/main.c")
target_link_libraries(aetheri_terminal_candidate PRIVATE files_original_terminal_session
    files_original_terminal_clipboard SDL3::SDL3 SDL3_ttf::SDL3_ttf PkgConfig::TERMINAL_WAYLAND m)
list(APPEND checked_targets files_original_modal files_original_editor_view aetheri_editor_candidate
    files_original_terminal_model files_original_terminal_pty files_original_terminal_session
    files_original_terminal_clipboard aetheri_terminal_candidate)
if(FILES_BUILD_TESTS)
    function(original_regression name source library)
        set(target "files_regression_${name}")
        add_executable(${target} "${AETHERI_SOURCE_DIR}/tests/${source}.c")
        target_link_libraries(${target} PRIVATE ${library})
        add_test(NAME ${name} COMMAND ${target})
        set(checked_targets ${checked_targets} ${target} PARENT_SCOPE)
    endfunction()
    original_regression(files.model test_files files_original_model)
    target_link_options(files_regression_files.model PRIVATE -Wl,--wrap=calloc)
    original_regression(files.layout test_files_layout files_original_model)
    original_regression(files.launch test_files_launch files_original_model)
    set_tests_properties(files.launch PROPERTIES TIMEOUT 15)
    original_regression(files.create test_files_create files_original_model)
    target_link_options(files_regression_files.create PRIVATE -Wl,--wrap=calloc,--wrap=fsync,--wrap=mkdirat)
    original_regression(files.rename test_files_rename files_original_model)
    target_link_options(files_regression_files.rename PRIVATE -Wl,--wrap=calloc,--wrap=fsync,--wrap=renameat2)
    original_regression(files.move test_files_move files_original_model)
    target_link_options(files_regression_files.move PRIVATE -Wl,--wrap=fsync,--wrap=renameat2)
    original_regression(text.graphemes test_grapheme files_original_text)
    original_regression(editor.document test_document files_original_document)
    target_link_options(files_regression_editor.document PRIVATE -Wl,--wrap=malloc,--wrap=calloc)
    foreach(name modal history search selection)
        original_regression(editor.${name} test_${name} files_original_modal)
        target_link_options(files_regression_editor.${name} PRIVATE -Wl,--wrap=malloc)
    endforeach()
    original_regression(editor.file test_editor_file files_original_file)
    target_compile_definitions(files_regression_editor.file PRIVATE _GNU_SOURCE)
    target_link_options(files_regression_editor.file PRIVATE -Wl,--wrap=malloc,--wrap=write,--wrap=fsync,--wrap=renameat2,--wrap=fgetxattr,--wrap=close)
    original_regression(editor.view test_editor_view files_original_editor_view)
    target_sources(files_regression_editor.view PRIVATE "${original}/terminal/model.c")
    foreach(name model selection paste composition)
        original_regression(terminal.${name} test_terminal_${name} files_original_terminal_model)
    endforeach()
    set_tests_properties(terminal.paste terminal.composition terminal.selection PROPERTIES TIMEOUT 10)
endif()
