@PACKAGE_INIT@
# Builder declaration only; this is not a verified provenance attestation.
set(NexaUI_SOURCE_REVISION "@NEXAUI_SOURCE_REVISION_NORMALIZED@")
set(NexaUI_Vulkan_FOUND @NEXAUI_PACKAGE_HAS_VULKAN@)
if(NOT WIN32)
    include(CMakeFindDependencyMacro)
    find_dependency(Threads)
    if(UNIX AND NOT APPLE)
        if(@NEXAUI_ENABLE_X11@)
            find_dependency(X11)
        endif()
        find_dependency(PkgConfig)
        pkg_check_modules(WAYLAND_CLIENT REQUIRED IMPORTED_TARGET wayland-client)
        pkg_check_modules(XKBCOMMON REQUIRED IMPORTED_TARGET xkbcommon)
        if(NexaUI_Vulkan_FOUND AND "Vulkan" IN_LIST NexaUI_FIND_COMPONENTS)
            find_dependency(Vulkan 1.3.250)
        endif()
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NexaUITargets.cmake")
check_required_components(NexaUI)
